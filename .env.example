# Copy to .env and fill in real values. .env is never committed.

# MySQL — used by docker-compose and the backend
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=life_tracker
MYSQL_USER=life_tracker
MYSQL_PASSWORD=change_me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Server secret for hashing login codes and signing JWT.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me